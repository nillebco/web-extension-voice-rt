{
  "manifest_version": 3,
  "name": "Speak with the web page",
  "version": "0.1",
  "description": "Too long to read? Let the web page speak to you. Ask for a summary, ask questions, execute simple functions. Available on all the pagesm includes a reader mode.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "polyfill.js",
        "voiceRealTime.js",
        "lib/Readability.js",
        "reader.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "permissions.html",
        "requestPermissions.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}